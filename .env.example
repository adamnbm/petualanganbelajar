# ==================================================
# KONFIGURASI ENVIRONMENT - SOKRABOT IPAS SD
# ==================================================
# Port server Express backend (default: 3001)
PORT=3001

# Google Gemini API Key (Dapatkan di https://aistudio.google.com/)
# PENTING: Jangan pernah membagikan atau mengunggah API key ke GitHub!
GEMINI_API_KEY=

# Model Gemini yang digunakan untuk evaluasi AI Tutor
GEMINI_MODEL=gemini-3.5-flash-lite

# ==================================================
# SUPABASE CLOUD DATABASE (DASHBOARD GURU)
# Dapatkan di https://supabase.com -> Project Settings -> API
# ==================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
